# ─── LLM Provider ────────────────────────────────────────────────────────────
# Pick ONE provider and fill in the key.
# Supported values: "anthropic" | "openai" | "gemini"
# Free tier recommendation: gemini (get a key at https://aistudio.google.com/apikey)
LLM_PROVIDER=gemini

# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite  (default, zero setup):
DATABASE_URL=sqlite:///./spur_chat.db

# PostgreSQL example (uncomment & fill to use Postgres):
# DATABASE_URL=postgresql://user:password@localhost:5432/spur_chat

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Max messages kept in LLM context window per conversation (cost control)
LLM_CONTEXT_WINDOW=20

# Hard cap on incoming user message length (characters)
MAX_MESSAGE_LENGTH=2000
